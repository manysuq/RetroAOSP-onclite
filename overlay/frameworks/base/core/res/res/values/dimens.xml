<?xml version="1.0" encoding="utf-8"?>
<!--
    RetroAOSP — геометрия Material Design 1: строгие углы 2dp вместо овалов Material You.
    Имена сверены с lineage-22.2 (Android 15):
      - dialog_corner_radius: радиус диалогов (тема Material ссылается на него
        через атрибут dialogCornerRadius; в A14 назывался config_dialogCornerRadius)
      - control_corner_material: радиус фона стандартных кнопок (dimens_material.xml)
      - notification_progress_segments_corner_radius: новые прогресс-уведомления A15
-->
<resources>
    <dimen name="dialog_corner_radius">2dp</dimen>
    <dimen name="control_corner_material">2dp</dimen>
    <dimen name="notification_progress_segments_corner_radius">2dp</dimen>
</resources>
