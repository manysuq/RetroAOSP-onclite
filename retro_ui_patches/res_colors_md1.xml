<?xml version="1.0" encoding="utf-8"?>
<!--
    RetroAOSP (NougatMod OS) — Цветовая палитра Material Design 1
    Переопределение системной темы Android 16: отключение пастельных тонов Monet
    и фиксация классических цветов Android 7 Nougat (Teal & Indigo).
-->
<resources>
    <!-- Основной системный акцент (Teal 500 из классической палитры MD1) -->
    <color name="system_accent1_0">#FF000000</color>
    <color name="system_accent1_10">#FF001F1C</color>
    <color name="system_accent1_50">#FF004D44</color>
    <color name="system_accent1_100">#FF007A6C</color>
    <color name="system_accent1_200">#FF009688</color> <!-- Главный цвет акцента Teal 500 -->
    <color name="system_accent1_300">#FF26A69A</color>
    <color name="system_accent1_400">#FF4DB6AC</color>
    <color name="system_accent1_500">#FF80CBC4</color>
    <color name="system_accent1_600">#FFB2DFDB</color>
    <color name="system_accent1_700">#FFE0F2F1</color>
    <color name="system_accent1_800">#FFF5FBFB</color>
    <color name="system_accent1_900">#FFFFFFFF</color>

    <!-- Второй акцент (Indigo 500 из классической палитры MD1) -->
    <color name="system_accent2_200">#FF3F51B5</color>
    <color name="system_accent2_500">#FF7986CB</color>

    <!-- Классические цвета статус-бара и панели навигации -->
    <color name="system_bar_background_semi_transparent">#66000000</color>
    <color name="status_bar_color_default">#FF000000</color>
    <color name="navigation_bar_color_default">#FF000000</color>

    <!-- Цвета активных элементов в шторке (Quick Settings) -->
    <color name="qs_tile_active_background">#FF009688</color> <!-- Активная плитка — Teal -->
    <color name="qs_tile_inactive_background">#FF37474F</color> <!-- Неактивная — Blue-Grey 800 -->
    <color name="qs_tile_disabled_background">#FF263238</color>

    <!-- Цвета анимации касания (Ripple) и эффекта прокрутки (Overscroll Glow) -->
    <color name="ripple_material_light">#33009688</color>
    <color name="ripple_material_dark">#33009688</color>
    <color name="edge_effect_device_default_light">#FF009688</color>
    <color name="edge_effect_device_default_dark">#FF009688</color>
</resources>
