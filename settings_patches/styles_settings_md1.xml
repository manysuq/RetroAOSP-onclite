<?xml version="1.0" encoding="utf-8"?>
<!--
    RetroAOSP — Стили приложения Настройки (Settings) под Material Design 1
    Отключение Collapsing Toolbar и компактные списки в стиле Android 7.
-->
<resources>
    <!-- Отключаем огромный Collapsing Toolbar, возвращаем классический плоский ActionBar -->
    <style name="Theme.Settings" parent="Theme.DeviceDefault.Settings">
        <item name="android:actionBarStyle">@style/RetroActionBar</item>
        <item name="android:listPreferredItemHeight">48dp</item> <!-- Компактная высота строк вместо 64dp+ -->
        <item name="android:listPreferredItemHeightSmall">40dp</item>
        <item name="android:colorAccent">#FF009688</item> <!-- Teal 500 для чекбоксов и ползунков -->
    </style>

    <style name="RetroActionBar" parent="android:Widget.DeviceDefault.ActionBar">
        <item name="android:elevation">4dp</item>
        <item name="android:background">#FF009688</item> <!-- Классический цвет шапки Настроек -->
        <item name="android:titleTextStyle">@style/RetroActionBarTitle</item>
    </style>

    <style name="RetroActionBarTitle" parent="android:TextAppearance.DeviceDefault.Widget.ActionBar.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">#FFFFFFFF</item>
    </style>
</resources>
