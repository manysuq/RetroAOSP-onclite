<?xml version="1.0" encoding="utf-8"?>
<!--
    RetroAOSP — Сетка шторки быстрых настроек и статус-бара (SystemUI)
    Возврат компактной сетки плиток и тонкого шрифта часов из Android 5-7.
-->
<resources>
    <!-- Сетка плиток Quick Settings: 3 столбца в портретной ориентации (вместо 2 пилюль) -->
    <integer name="quick_settings_num_columns">3</integer>
    <integer name="quick_settings_max_rows">3</integer>
    
    <!-- Включаем компактные иконки вместо текста с описанием внутри пилюли -->
    <bool name="config_quickSettingsShowIconOnly">true</bool>

    <!-- Тонкий шрифт для виджетов часов на экране блокировки и рабочем столе (Roboto Light) -->
    <string name="clock_font_family">sans-serif-light</string>
    <dimen name="widget_clock_font_size">64sp</dimen>
    <dimen name="status_bar_clock_size">14sp</dimen>

    <!-- Отключаем современные эффекты прозрачности/размытия шторки в пользу плотных цветов MD1 -->
    <color name="qs_background_dark">#FF263238</color> <!-- Blue-Grey 900 как в Nougat -->
    <dimen name="qs_panel_elevation">4dp</dimen>
</resources>
