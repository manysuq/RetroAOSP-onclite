<?xml version="1.0" encoding="utf-8"?>
<!--
    RetroAOSP (NougatMod OS) — Конфигурация SystemUI (config.xml)
    Переопределение реальных параметров AOSP / LineageOS в packages/SystemUI/res/values/config.xml
-->
<resources>
    <!-- Возвращаем классическую сетку 3x3 для панели Quick Settings (вместо 2 пилюль в ряд) -->
    <integer name="quick_settings_num_columns">3</integer>
    <integer name="quick_settings_max_rows">3</integer>

    <!-- Отключаем современные анимации и размытие фона за шторкой уведомлений -->
    <bool name="config_enableNotificationsBlur">false</bool>
    <bool name="config_enableQsBlur">false</bool>
    
    <!-- Включаем классическое отображение значков в шторке и статус-баре -->
    <bool name="config_quickSettingsShowIconOnly">true</bool>
    <bool name="config_showPercentageTextDuringCharge">true</bool>
</resources>
