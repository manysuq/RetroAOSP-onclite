<?xml version="1.0" encoding="UTF-8"?>
<!--
    Локальный манифест для сборки RetroAOSP (Android 15 / LineageOS 22.2)
    Поддержка устройства: Xiaomi Redmi 7 (кодовое имя: onclite / onc)
    Платформа: Qualcomm Snapdragon 632 (msm8953)

    ВАЖНО: с lineage-22.2 дерево onclite самостоятельное — общий msm8953-common
    больше не нужен (проверено: BoardConfig.mk ссылается только на vendor/xiaomi/onclite,
    lineage.dependencies содержит только hardware/xiaomi и ядро).
-->
<manifest>
    <!-- Дерево устройства (Device Tree) для Redmi 7 -->
    <project path="device/xiaomi/onclite" name="LineageOS/android_device_xiaomi_onclite" remote="github" revision="lineage-22.2" />

    <!-- Проприетарные бинарники и библиотеки (Vendor Tree) -->
    <project path="vendor/xiaomi/onclite" name="TheMuppets/proprietary_vendor_xiaomi_onclite" remote="github" revision="lineage-22.2" />

    <!-- Ядро (согласно lineage.dependencies) -->
    <project path="kernel/xiaomi/onclite" name="LineageOS/android_kernel_xiaomi_onclite" remote="github" revision="lineage-22.2" />

    <!-- Аппаратные HAL-модули Xiaomi (согласно lineage.dependencies) -->
    <project path="hardware/xiaomi" name="LineageOS/android_hardware_xiaomi" remote="github" revision="lineage-22.2" />
</manifest>
