<?xml version="1.0" encoding="UTF-8"?>
<!--
    Локальный манифест для сборки RetroAOSP (Android 14-16 / LineageOS 21+)
    Поддержка устройства: Xiaomi Redmi 7 (кодовое имя: onclite / onc)
    Платформа: Qualcomm Snapdragon 632 (msm8953)
-->
<manifest>
    <!-- Основной репозиторий деревьев устройства (Device Tree) для Redmi 7 -->
    <project path="device/xiaomi/onclite" name="LineageOS/android_device_xiaomi_onclite" remote="github" revision="lineage-21" />

    <!-- Общее дерево для платформы msm8953 -->
    <project path="device/xiaomi/msm8953-common" name="LineageOS/android_device_xiaomi_msm8953-common" remote="github" revision="lineage-21" />

    <!-- Проприетарные бинарники и библиотеки (Vendor Tree) для Redmi 7 -->
    <project path="vendor/xiaomi/onclite" name="TheMuppets/proprietary_vendor_xiaomi_onclite" remote="github" revision="lineage-21" />
    
    <!-- КРИТИЧЕСКИ ВАЖНО: У TheMuppets для msm8953-common существует ТОЛЬКО ветка lineage-20. 
         Жестко фиксируем revision="lineage-20", иначе repo sync упадет с ошибкой "remote ref not found" -->
    <project path="vendor/xiaomi/msm8953-common" name="TheMuppets/proprietary_vendor_xiaomi_msm8953-common" remote="github" revision="lineage-20" />

    <!-- КРИТИЧЕСКИ ВАЖНО: Согласно официальному lineage.dependencies устройства onclite,
         требуется выделенное ядро android_kernel_xiaomi_onclite по пути kernel/xiaomi/onclite -->
    <project path="kernel/xiaomi/onclite" name="LineageOS/android_kernel_xiaomi_onclite" remote="github" revision="lineage-21" />

    <!-- Аппаратные HAL-модули и зависимости Xiaomi -->
    <project path="hardware/xiaomi" name="LineageOS/android_hardware_xiaomi" remote="github" revision="lineage-21" />
</manifest>
